#!/usr/bin/env python
"""{{PROJECT_NAME}} scraper CLI.

Library-based project using Sapphire as a dependency.
"""
import sys
from pathlib import Path

import typer

from sapphire import load_config, run_scraper_sync, StorageBackend, default_sapphire_mapper

# Optional: Import custom mapper if exists
try:
    from mapper import map_provider
except ImportError:
    map_provider = None

app = typer.Typer(help="{{PROJECT_NAME}} provider directory scraper")
PROJECT_DIR = Path(__file__).parent


@app.command()
def run(
    curr: str = typer.Option(..., "--curr", "-c", help="Current date (YYYYMMDD)"),
    prev: str = typer.Option(None, "--prev", "-p", help="Previous date for comparison"),
    phase: int = typer.Option(None, "--phase", help="Run specific phase (1-5)"),
    storage: str = typer.Option("sqlite", "--storage", "-s", help="Storage backend: sqlite, json_files, jsonl"),
    qa: bool = typer.Option(False, "--qa", help="Run full QA phase after scraping"),
    report: bool = typer.Option(False, "--report", help="Run full Report phase after QA"),
    dry_run: bool = typer.Option(False, "--dry-run", "-n", help="Validate without executing"),
):
    """Run the scraper pipeline."""
    config = load_config("{{PROJECT_SLUG}}")

    storage_map = {
        "sqlite": StorageBackend.SQLITE,
        "json_files": StorageBackend.JSON_FILES,
        "jsonl": StorageBackend.JSONL,
    }
    storage_backend = storage_map.get(storage.lower(), StorageBackend.SQLITE)

    if dry_run:
        typer.echo(f"[DRY RUN] Would run {{PROJECT_NAME}} for {curr}")
        typer.echo(f"  Config: {config.project.name}")
        typer.echo(f"  States: {', '.join(config.coverage.states)}")
        typer.echo(f"  Networks: {len(config.networks)}")
        typer.echo(f"  Custom mapper: {'Yes' if map_provider else 'No (using default)'}")
        if phase:
            typer.echo(f"  Phase: {phase}")
        return

    result = run_scraper_sync(
        config=config,
        curr_date=curr,
        prev_date=prev,
        phase=phase,
        mapper=map_provider,
        storage_backend=storage_backend,
        run_qa=qa,
        run_report=report,
    )

    if result.success:
        typer.echo(f"Completed: {result.providers_count} providers")
        for phase_num, phase_result in result.phase_results.items():
            status = "OK" if phase_result.success else "FAILED"
            typer.echo(f"  Phase {phase_num}: {status} - {phase_result.message}")
    else:
        typer.echo(f"Failed: {result.error}", err=True)
        sys.exit(1)


@app.command()
def qa(
    curr: str = typer.Option(..., "--curr", "-c", help="Current date (YYYYMMDD)"),
    prev: str = typer.Option(None, "--prev", "-p", help="Previous date for comparison"),
):
    """Run QA phase only (validation + comparison)."""
    config = load_config("{{PROJECT_SLUG}}")

    result = run_scraper_sync(
        config=config,
        curr_date=curr,
        prev_date=prev,
        phase=4,
        run_qa=True,
    )

    if result.success and 4 in result.phase_results:
        qa_result = result.phase_results[4]
        typer.echo(f"QA: {qa_result.message}")
        if qa_result.data:
            for key, value in qa_result.data.items():
                typer.echo(f"  {key}: {value}")
    else:
        typer.echo(f"QA failed: {result.error}", err=True)
        sys.exit(1)


@app.command()
def report(
    curr: str = typer.Option(..., "--curr", "-c", help="Current date (YYYYMMDD)"),
    prev: str = typer.Option(None, "--prev", "-p", help="Previous date for comparison"),
    samples: int = typer.Option(10, "--samples", help="Number of sample providers"),
):
    """Generate Excel report and samples."""
    config = load_config("{{PROJECT_SLUG}}")

    result = run_scraper_sync(
        config=config,
        curr_date=curr,
        prev_date=prev,
        phase=5,
        run_report=True,
        sample_count=samples,
    )

    if result.success and 5 in result.phase_results:
        report_result = result.phase_results[5]
        typer.echo(f"Report: {report_result.message}")
        if report_result.data:
            for key, value in report_result.data.items():
                typer.echo(f"  {key}: {value}")
    else:
        typer.echo(f"Report generation failed: {result.error}", err=True)
        sys.exit(1)


@app.command()
def validate():
    """Validate project configuration."""
    config = load_config("{{PROJECT_SLUG}}")
    typer.echo(f"Configuration valid: {config.project.name}")
    typer.echo(f"  Domain: {config.site.domain}")
    typer.echo(f"  Networks: {len(config.networks)}")
    typer.echo(f"  States: {', '.join(config.coverage.states)}")
    typer.echo(f"  Storage: {config.output.storage_backend.value}")
    typer.echo(f"  Custom mapper: {'Yes' if map_provider else 'No (using default)'}")


if __name__ == "__main__":
    app()
