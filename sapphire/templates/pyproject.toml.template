[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[project]
name = "{{PROJECT_SLUG}}"
version = "1.0.0"
description = "{{PROJECT_NAME}} provider directory scraper"
requires-python = ">=3.11"
dependencies = [
    "sapphire",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
    "pytest-asyncio>=0.24",
    "mypy>=1.0",
]

[project.scripts]
{{PROJECT_SLUG}}-scraper = "run:app"

[tool.setuptools]
py-modules = ["run", "mapper"]

# uv configuration (recommended)
[tool.uv]
dev-dependencies = [
    "pytest>=8.0",
    "pytest-asyncio>=0.24",
    "mypy>=1.0",
]

[tool.uv.sources]
sapphire = { path = "../sapphire", editable = true }
