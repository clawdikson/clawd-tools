# Proxy configuration (via core.proxy.ProxyManager)
# Uses Decodo DC proxy by default
DECODO_DC_USERNAME=
DECODO_DC_PASSWORD=

# Alternative: Custom proxy URL
# SAPPHIRE_PROXY_URL=http://proxy.example.com:8080
# SAPPHIRE_PROXY_USERNAME=
# SAPPHIRE_PROXY_PASSWORD=

# Browser automation
SAPPHIRE_HEADLESS=true
SAPPHIRE_BROWSER_TIMEOUT=30

# Debugging
SAPPHIRE_DEBUG=false
SAPPHIRE_LOG_LEVEL=INFO
