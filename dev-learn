// Parse command line arguments
function parseArgs(argv) {
  const args = { _: [] };
  
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    
    if (arg.startsWith('--')) {
      const [key, value] = arg.slice(2).split('=');
      if (value !== undefined) {
        args[key] = value;
      } else if (i + 1 < argv.length && !argv[i + 1].startsWith('-')) {
        args[key] = argv[++i];
      } else {
        args[key] = true;
      }
    } else if (arg.startsWith('-')) {
      const flags = arg.slice(1);
      if (flags.length === 1 && i + 1 < argv.length && !argv[i + 1].startsWith('-')) {
        args[flags] = argv[++i];
      } else {
        for (const flag of flags) {
          args[flag] = true;
        }
      }
    } else {
      args._.push(arg);
    }
  }
  
  return args;
}

// Main function
function main() {
  const args = parseArgs(process.argv.slice(2));
  const command = args._[0];
  
  // Initialize data storage
  initializeData();
  
  // Route commands
  switch (command) {
    case 'add':
      addLearning(args);
      break;
    case 'list':
    case 'ls':
      listLearnings(args);
      break;
    case 'search':
    case 'find':
      searchLearnings(args);
      break;
    case 'today':
      showToday(args);
      break;
    case 'stats':
    case 'statistics':
      showStats(args);
      break;
    case 'categories':
    case 'cats':
      showCategories();
      break;
    case 'help':
    case '--help':
    case '-h':
    default:
      showHelp();
      break;
  }
}

// Run the CLI
if (require.main === module) {
  main();
}