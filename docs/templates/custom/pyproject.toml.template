[project]
name = "audiobee-{{PROJECT_SLUG}}"
version = "1.0.0"
description = "{{PROJECT_NAME}} provider scraper"
requires-python = ">=3.12"
dependencies = [
    "typer>=0.9.0",
    "pyyaml>=6.0",
    "pydantic>=2.0",
    "python-dotenv>=1.0",
    "tqdm>=4.65",
    "core",  # Local core package
]

[project.optional-dependencies]
# Feature-based extras
captcha = ["httpx>=0.24.0"]  # For Capsolver API
browser = ["patchright>=1.57", "camoufox>=0.4"]
http = ["httpx>=0.25", "curl-cffi>=0.6"]

# Bundle for this carrier (adjust based on needs)
full = [
    "audiobee-{{PROJECT_SLUG}}[http]",
]

[project.scripts]
{{PROJECT_SLUG}} = "run:app"

[build-system]
requires = ["setuptools>=68.0.0", "wheel"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
include = ["*.py"]

[tool.ruff]
target-version = "py312"
line-length = 100

[tool.ruff.lint]
select = ["E", "W", "F", "I", "B", "C4", "UP"]
ignore = ["E501", "E402"]
