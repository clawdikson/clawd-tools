    def get_record_id(self, record: dict[str, Any]) -> str:
        """Extract unique ID for storage key.

        TODO: Customize based on your data structure.
        """
        return record.get("npi") or record.get("providerId") or str(hash(str(record)))

    async def run(self) -> CollectResult:
        """Execute collection with checkpointing."""
        await self.setup()
        try:
            count = 0
            errors = []

            async for record in self.collect():
                record_id = self.get_record_id(record)

                # Skip if already collected (resume)
                if self.checkpoint.is_collected(record_id):
                    self.resumed_count += 1
                    continue

                try:
                    self.store.put(f"{record_id}.json", record)
                    self.checkpoint.mark_collected(record_id)
                    count += 1
                except Exception as e:
                    errors.append(f"{record_id}: {e}")
                    logger.error(f"Failed to store {record_id}: {e}")

            self.store.flush()
            self.checkpoint.flush()

            if self.resumed_count > 0:
                logger.info(f"Resumed: skipped {self.resumed_count} already collected")

            return CollectResult(
                success=len(errors) == 0,
                records_collected=count,
                records_resumed=self.resumed_count,
                errors=errors if errors else None,
            )
        finally:
            await self.teardown()


def run_collect_sync(
    config: CollectorConfig,
    curr_date: str,
    fresh: bool = False
) -> CollectResult:
    """Synchronous wrapper for collection."""
    collector = {{CLASS_NAME}}Collector(config, curr_date, fresh)
    return asyncio.run(collector.run())
