    success: bool
    records_collected: int
    records_resumed: int = 0
    errors: list[str] | None = None


class Checkpoint:
    """SQLite-based checkpoint for resume capability.

    Checkpointing is MANDATORY for all collectors. This ensures
    that interrupted runs can resume from where they left off.
    """

    def __init__(self, db_path: Path):
        self.db_path = db_path
        self.conn = sqlite3.connect(db_path)
        self._init_tables()

    def _init_tables(self):
        """Create checkpoint tables if they don't exist."""
        self.conn.execute("""
            CREATE TABLE IF NOT EXISTS progress (
                key TEXT PRIMARY KEY,
                value TEXT,
                updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)
        self.conn.execute("""
            CREATE TABLE IF NOT EXISTS collected_ids (
                record_id TEXT PRIMARY KEY,
                collected_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)
        self.conn.commit()

    def is_collected(self, record_id: str) -> bool:
        """Check if a record has already been collected."""
        cur = self.conn.execute(
            "SELECT 1 FROM collected_ids WHERE record_id = ?", (record_id,)
        )
        return cur.fetchone() is not None

    def mark_collected(self, record_id: str):
        """Mark a record as collected."""
        self.conn.execute(
            "INSERT OR REPLACE INTO collected_ids (record_id) VALUES (?)",
            (record_id,)
        )

    def get_progress(self, key: str) -> str | None:
        """Get a progress value by key."""
        cur = self.conn.execute(
            "SELECT value FROM progress WHERE key = ?", (key,)
        )
        row = cur.fetchone()
        return row[0] if row else None

    def set_progress(self, key: str, value: str):
        """Set a progress value."""
        self.conn.execute(
            "INSERT OR REPLACE INTO progress (key, value) VALUES (?, ?)",
            (key, value)
        )
        self.conn.commit()

    def flush(self):
        """Ensure all changes are persisted."""
        self.conn.commit()

    def close(self):
        """Close the database connection."""
        self.conn.close()


