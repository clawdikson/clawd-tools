#!/usr/bin/env node

const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

// Colors for terminal output
const colors = {
    reset: '\x1b[0m',
    bright: '\x1b[1m',
    red: '\x1b[31m',
    green: '\x1b[32m',
    yellow: '\x1b[33m',
    blue: '\x1b[34m',
    magenta: '\x1b[35m',
    cyan: '\x1b[36m',
    gray: '\x1b[90m'
};

// Data storage directory
const dataDir = path.join(process.env.HOME, '.meeting-notes');
const meetingsFile = path.join(dataDir, 'meetings.json');
const templatesFile = path.join(dataDir, 'templates.json');

// Initialize data directory and files
function initializeStorage() {
    if (!fs.existsSync(dataDir)) {
        fs.mkdirSync(dataDir, { recursive: true });
    }
    
    if (!fs.existsSync(meetingsFile)) {
        fs.writeFileSync(meetingsFile, JSON.stringify({ meetings: [] }, null, 2));
    }
    
    if (!fs.existsSync(templatesFile)) {
        const defaultTemplates = {
            "1-on-1": {
                sections: ["Previous Action Items", "Current Projects", "Blockers", "Goals", "Feedback", "Next Actions"],
                defaultDuration: 30
            },
            "standup": {
                sections: ["Yesterday", "Today", "Blockers", "Notes"],
                defaultDuration: 15
            },
            "planning": {
                sections: ["Objectives", "Requirements", "Timeline", "Resources", "Risks", "Decisions", "Action Items"],
                defaultDuration: 60
            },
            "retrospective": {
                sections: ["What Went Well", "What Could Improve", "Action Items", "Experiments"],
                defaultDuration: 45
            },
            "general": {
                sections: ["Agenda", "Discussion", "Decisions", "Action Items", "Next Steps"],
                defaultDuration: 30
            }
        };
        fs.writeFileSync(templatesFile, JSON.stringify(defaultTemplates, null, 2));
    }
}

// Get current NST time
function getNSTTime() {
    const now = new Date();
    const nstOffset = -3.5; // NST is UTC-3:30
    const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
    const nst = new Date(utc + (nstOffset * 3600000));
    return nst;
}

// Format date for NST
function formatNSTDate(date) {
    const nst = date || getNSTTime();
    return nst.toLocaleDateString('en-CA') + ' ' + nst.toLocaleTimeString('en-US', { 
        hour: '2-digit', 
        minute: '2-digit',
        hour12: false 
    });
}

// Load meetings data
function loadMeetings() {
    try {
        const data = JSON.parse(fs.readFileSync(meetingsFile, 'utf8'));
        // Handle legacy format (array) vs new format (object with meetings property)
        if (Array.isArray(data)) {
            return { meetings: [] }; // Reset legacy format to new structure
        }
        return data;
    } catch (error) {
        return { meetings: [] };
    }
}

// Save meetings data
function saveMeetings(data) {
    fs.writeFileSync(meetingsFile, JSON.stringify(data, null, 2));
}

// Load templates
function loadTemplates() {
    try {
        return JSON.parse(fs.readFileSync(templatesFile, 'utf8'));
    } catch (error) {
        return {};
    }
}

// Generate unique meeting ID
function generateMeetingId() {
    return Date.now().toString(36) + Math.random().toString(36).substr(2);
}

// Create new meeting
function createMeeting(options) {
    const data = loadMeetings();
    const templates = loadTemplates();
    const template = templates[options.template] || templates.general;
    
    const meeting = {
        id: generateMeetingId(),
        title: options.title,
        type: options.template || 'general',
        date: formatNSTDate(),
        duration: options.duration || template.defaultDuration,
        attendees: options.attendees || [],
        sections: {},
        actionItems: [],
        decisions: [],
        nextMeeting: options.nextMeeting || null,
        tags: options.tags || []
    };
    
    // Initialize sections from template
    template.sections.forEach(section => {
        meeting.sections[section] = "";
    });
    
    data.meetings.push(meeting);
    saveMeetings(data);
    
    console.log(`${colors.green}✅ Created meeting: ${meeting.title}${colors.reset}`);
    console.log(`${colors.gray}   ID: ${meeting.id}${colors.reset}`);
    console.log(`${colors.gray}   Date: ${meeting.date}${colors.reset}`);
    console.log(`${colors.gray}   Template: ${meeting.type}${colors.reset}`);
    
    return meeting.id;
}

// Add content to meeting section
function addToSection(meetingId, section, content) {
    const data = loadMeetings();
    const meeting = data.meetings.find(m => m.id === meetingId);
    
    if (!meeting) {
        console.log(`${colors.red}❌ Meeting not found: ${meetingId}${colors.reset}`);
        return;
    }
    
    if (!meeting.sections.hasOwnProperty(section)) {
        meeting.sections[section] = "";
    }
    
    if (meeting.sections[section]) {
        meeting.sections[section] += "\n";
    }
    meeting.sections[section] += `• ${content}`;
    
    saveMeetings(data);
    console.log(`${colors.green}✅ Added to ${section}: ${content}${colors.reset}`);
}

// Add action item
function addActionItem(meetingId, item, assignee = null, dueDate = null) {
    const data = loadMeetings();
    const meeting = data.meetings.find(m => m.id === meetingId);
    
    if (!meeting) {
        console.log(`${colors.red}❌ Meeting not found: ${meetingId}${colors.reset}`);
        return;
    }
    
    const actionItem = {
        id: generateMeetingId(),
        description: item,
        assignee: assignee,
        dueDate: dueDate,
        status: 'open',
        created: formatNSTDate()
    };
    
    meeting.actionItems.push(actionItem);
    saveMeetings(data);
    
    console.log(`${colors.green}✅ Added action item: ${item}${colors.reset}`);
    if (assignee) console.log(`${colors.gray}   Assigned to: ${assignee}${colors.reset}`);
    if (dueDate) console.log(`${colors.gray}   Due: ${dueDate}${colors.reset}`);
}

// Add decision
function addDecision(meetingId, decision) {
    const data = loadMeetings();
    const meeting = data.meetings.find(m => m.id === meetingId);
    
    if (!meeting) {
        console.log(`${colors.red}❌ Meeting not found: ${meetingId}${colors.reset}`);
        return;
    }
    
    meeting.decisions.push({
        description: decision,
        timestamp: formatNSTDate()
    });
    
    saveMeetings(data);
    console.log(`${colors.green}✅ Added decision: ${decision}${colors.reset}`);
}

// List recent meetings
function listMeetings(limit = 10, filter = null) {
    const data = loadMeetings();
    let meetings = data.meetings
        .sort((a, b) => new Date(b.date) - new Date(a.date))
        .slice(0, limit);
    
    if (filter) {
        meetings = meetings.filter(m => 
            m.title.toLowerCase().includes(filter.toLowerCase()) ||
            m.type.toLowerCase().includes(filter.toLowerCase()) ||
            m.attendees.some(a => a.toLowerCase().includes(filter.toLowerCase()))
        );
    }
    
    if (meetings.length === 0) {
        console.log(`${colors.yellow}📝 No meetings found${colors.reset}`);
        return;
    }
    
    console.log(`${colors.bright}📅 Recent Meetings${colors.reset}\n`);
    
    meetings.forEach(meeting => {
        const actionCount = meeting.actionItems.length;
        const decisionCount = meeting.decisions.length;
        
        console.log(`${colors.cyan}${meeting.title}${colors.reset} ${colors.gray}(${meeting.type})${colors.reset}`);
        console.log(`${colors.gray}   ID: ${meeting.id}${colors.reset}`);
        console.log(`${colors.gray}   Date: ${meeting.date} • ${meeting.duration}min${colors.reset}`);
        if (meeting.attendees.length > 0) {
            console.log(`${colors.gray}   Attendees: ${meeting.attendees.join(', ')}${colors.reset}`);
        }
        console.log(`${colors.gray}   ${actionCount} action items • ${decisionCount} decisions${colors.reset}`);
        console.log();
    });
}

// Show meeting details
function showMeeting(meetingId) {
    const data = loadMeetings();
    const meeting = data.meetings.find(m => m.id === meetingId);
    
    if (!meeting) {
        console.log(`${colors.red}❌ Meeting not found: ${meetingId}${colors.reset}`);
        return;
    }
    
    console.log(`${colors.bright}📅 ${meeting.title}${colors.reset}`);
    console.log(`${colors.gray}Type: ${meeting.type} • Date: ${meeting.date} • Duration: ${meeting.duration}min${colors.reset}`);
    
    if (meeting.attendees.length > 0) {
        console.log(`${colors.gray}Attendees: ${meeting.attendees.join(', ')}${colors.reset}`);
    }
    
    console.log();
    
    // Show sections
    Object.entries(meeting.sections).forEach(([section, content]) => {
        console.log(`${colors.blue}## ${section}${colors.reset}`);
        if (content.trim()) {
            console.log(content);
        } else {
            console.log(`${colors.gray}(no notes)${colors.reset}`);
        }
        console.log();
    });
    
    // Show decisions
    if (meeting.decisions.length > 0) {
        console.log(`${colors.magenta}## Decisions${colors.reset}`);
        meeting.decisions.forEach(decision => {
            console.log(`• ${decision.description} ${colors.gray}(${decision.timestamp})${colors.reset}`);
        });
        console.log();
    }
    
    // Show action items
    if (meeting.actionItems.length > 0) {
        console.log(`${colors.yellow}## Action Items${colors.reset}`);
        meeting.actionItems.forEach(item => {
            const status = item.status === 'open' ? '🔴' : '✅';
            const assignee = item.assignee ? ` → ${item.assignee}` : '';
            const due = item.dueDate ? ` (due: ${item.dueDate})` : '';
            console.log(`${status} ${item.description}${assignee}${due}`);
        });
        console.log();
    }
}

// Search meetings
function searchMeetings(query) {
    const data = loadMeetings();
    const results = data.meetings.filter(meeting => {
        const searchText = (
            meeting.title + ' ' + 
            meeting.type + ' ' + 
            Object.values(meeting.sections).join(' ') + ' ' +
            meeting.actionItems.map(a => a.description).join(' ') + ' ' +
            meeting.decisions.map(d => d.description).join(' ') + ' ' +
            meeting.attendees.join(' ')
        ).toLowerCase();
        
        return searchText.includes(query.toLowerCase());
    });
    
    if (results.length === 0) {
        console.log(`${colors.yellow}📝 No meetings found matching "${query}"${colors.reset}`);
        return;
    }
    
    console.log(`${colors.bright}🔍 Search Results for "${query}"${colors.reset}\n`);
    
    results.forEach(meeting => {
        console.log(`${colors.cyan}${meeting.title}${colors.reset} ${colors.gray}(${meeting.date})${colors.reset}`);
        console.log(`${colors.gray}   ID: ${meeting.id}${colors.reset}`);
        console.log();
    });
}

// Show all open action items
function showOpenActions() {
    const data = loadMeetings();
    const allActions = [];
    
    data.meetings.forEach(meeting => {
        meeting.actionItems.forEach(item => {
            if (item.status === 'open') {
                allActions.push({
                    ...item,
                    meetingTitle: meeting.title,
                    meetingDate: meeting.date
                });
            }
        });
    });
    
    if (allActions.length === 0) {
        console.log(`${colors.green}🎉 No open action items!${colors.reset}`);
        return;
    }
    
    console.log(`${colors.bright}📋 Open Action Items (${allActions.length})${colors.reset}\n`);
    
    allActions.sort((a, b) => new Date(a.dueDate || '9999-12-31') - new Date(b.dueDate || '9999-12-31'))
             .forEach(action => {
        const assignee = action.assignee ? ` → ${action.assignee}` : '';
        const due = action.dueDate ? ` ${colors.yellow}(due: ${action.dueDate})${colors.reset}` : '';
        console.log(`🔴 ${action.description}${assignee}${due}`);
        console.log(`${colors.gray}   From: ${action.meetingTitle} (${action.meetingDate})${colors.reset}`);
        console.log();
    });
}

