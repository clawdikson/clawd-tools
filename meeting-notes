// Main CLI handler
function main() {
    initializeStorage();
    
    const args = process.argv.slice(2);
    
    if (args.length === 0) {
        showHelp();
        return;
    }
    
    const command = args[0];
    
    switch (command) {
        case 'create': {
            if (args.length < 2) {
                console.log(`${colors.red}❌ Missing meeting title${colors.reset}`);
                return;
            }
            
            const title = args[1];
            const options = { title };
            
            for (let i = 2; i < args.length; i += 2) {
                const flag = args[i];
                const value = args[i + 1];
                
                switch (flag) {
                    case '--type':
                        options.template = value;
                        break;
                    case '--duration':
                        options.duration = parseInt(value);
                        break;
                    case '--attendees':
                        options.attendees = value.split(',').map(a => a.trim());
                        break;
                    case '--next':
                        options.nextMeeting = value;
                        break;
                    case '--tags':
                        options.tags = value.split(',').map(t => t.trim());
                        break;
                }
            }
            
            createMeeting(options);
            break;
        }
        
        case 'add': {
            if (args.length < 4) {
                console.log(`${colors.red}❌ Usage: meeting-notes add <meeting-id> <section> <content>${colors.reset}`);
                return;
            }
            
            const meetingId = args[1];
            const section = args[2];
            const content = args.slice(3).join(' ');
            
            addToSection(meetingId, section, content);
            break;
        }
        
        case 'action': {
            if (args.length < 3) {
                console.log(`${colors.red}❌ Usage: meeting-notes action <meeting-id> <description>${colors.reset}`);
                return;
            }
            
            const meetingId = args[1];
            const description = args.slice(2).join(' ').replace(/--assignee.*|--due.*/, '').trim();
            
            let assignee = null;
            let dueDate = null;
            
            const assigneeIndex = args.indexOf('--assignee');
            if (assigneeIndex !== -1 && assigneeIndex + 1 < args.length) {
                assignee = args[assigneeIndex + 1];
            }
            
            const dueIndex = args.indexOf('--due');
            if (dueIndex !== -1 && dueIndex + 1 < args.length) {
                dueDate = args[dueIndex + 1];
            }
            
            addActionItem(meetingId, description, assignee, dueDate);
            break;
        }
        
        case 'decision': {
            if (args.length < 3) {
                console.log(`${colors.red}❌ Usage: meeting-notes decision <meeting-id> <description>${colors.reset}`);
                return;
            }
            
            const meetingId = args[1];
            const decision = args.slice(2).join(' ');
            
            addDecision(meetingId, decision);
            break;
        }
        
        case 'show': {
            if (args.length < 2) {
                console.log(`${colors.red}❌ Usage: meeting-notes show <meeting-id>${colors.reset}`);
                return;
            }
            
            showMeeting(args[1]);
            break;
        }
        
        case 'list': {
            const limit = args[1] ? parseInt(args[1]) : 10;
            const filterIndex = args.indexOf('--filter');
            const filter = filterIndex !== -1 && filterIndex + 1 < args.length ? args[filterIndex + 1] : null;
            
            listMeetings(limit, filter);
            break;
        }
        
        case 'search': {
            if (args.length < 2) {
                console.log(`${colors.red}❌ Usage: meeting-notes search <query>${colors.reset}`);
                return;
            }
            
            const query = args.slice(1).join(' ');
            searchMeetings(query);
            break;
        }
        
        case 'actions': {
            showOpenActions();
            break;
        }
        
        case 'help':
        case '--help':
        case '-h': {
            showHelp();
            break;
        }
        
        default: {
            console.log(`${colors.red}❌ Unknown command: ${command}${colors.reset}`);
            console.log(`Run 'meeting-notes help' for usage information.`);
        }
    }
}

if (require.main === module) {
    main();
}