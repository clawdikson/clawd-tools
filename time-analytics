// Main CLI handler
function main() {
  const args = process.argv.slice(2);
  const command = args[0];
  
  switch (command) {
    case 'start':
      if (!args[1]) {
        console.log(`${RED}Error: Category required${RESET}`);
        console.log(`Use: time-analytics categories`);
        return;
      }
      startSession(args[1], args.slice(2).join(' '));
      break;
      
    case 'stop':
      stopSession(args[1]);
      break;
      
    case 'switch':
      if (!args[1]) {
        console.log(`${RED}Error: Category required${RESET}`);
        console.log(`Use: time-analytics categories`);
        return;
      }
      switchSession(args[1], args.slice(2).join(' '));
      break;
      
    case 'status':
      showStatus();
      break;
      
    case 'analytics':
      showAnalytics(parseInt(args[1]) || 7);
      break;
      
    case 'categories':
      listCategories();
      break;
      
    case 'help':
    case '--help':
    case '-h':
      showHelp();
      break;
      
    default:
      if (!command) {
        showStatus();
      } else {
        console.log(`${RED}Unknown command: ${command}${RESET}`);
        showHelp();
      }
      break;
  }
}

if (require.main === module) {
  main();
}