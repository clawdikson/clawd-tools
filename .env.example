# =============================================================================
# Ideon Scraping - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# NEVER commit .env to version control - it contains secrets!
# =============================================================================

# =============================================================================
# Proxy Type Selection
# =============================================================================
# Available proxy types (by tier):
#   1. none                  - No proxy
#   2. decodo_dc_static      - Decodo datacenter static IPs
#   3. surfshark             - Surfshark VPN
#   4. nordvpn               - NordVPN
#   5. dataimpulse_rotating  - DataImpulse rotating residential (new IP each request)
#   6. dataimpulse_session   - DataImpulse session-based residential (sticky IP)
#   7. smartproxy_rotating   - SmartProxy rotating residential (new IP each request)
#   8. smartproxy_session    - SmartProxy session-based residential (sticky IP)
#
# Use PROXY_TYPES for multiple types (comma-separated, round-robin):
#   PROXY_TYPES=smartproxy_session,dataimpulse_rotating,surfshark
# Or use PROXY_TYPE for single type (backward compatibility):
#   PROXY_TYPE=dataimpulse_session

PROXY_TYPES=
PROXY_TYPE=none

# =============================================================================
# Decodo Datacenter Configuration (Tier 2)
# Documentation: https://help.decodo.com/docs/datacenter-pay-per-ip-proxy-quick-start
# =============================================================================
DECODO_DC_USERNAME=
DECODO_DC_PASSWORD=
DECODO_DC_HOST=dc.decodo.com
DECODO_DC_PORT_MIN=10001
DECODO_DC_PORT_MAX=10100

# =============================================================================
# VPN Authentication (Tier 3-4)
# =============================================================================
# Surfshark VPN
SURFSHARK_USERNAME=
SURFSHARK_PASSWORD=

# NordVPN
NORD_USERNAME=
NORD_PASSWORD=

# =============================================================================
# DataImpulse Configuration (Tier 5-6)
# Documentation: https://docs.dataimpulse.com/proxies/types-of-connections
# =============================================================================
DATAIMPULSE_PROXY_HOST=gw.dataimpulse.com
DATAIMPULSE_PROXY_USERNAME=
DATAIMPULSE_PROXY_PASSWORD=

# Session mode configuration
DATAIMPULSE_PORT_MIN=10000
DATAIMPULSE_PORT_MAX=20000
DATAIMPULSE_SESSION_DURATION=30

# =============================================================================
# SmartProxy / Decodo Residential Configuration (Tier 7-8)
# Documentation: https://help.decodo.com/docs/residential-proxy-quick-start
# =============================================================================
SMARTPROXY_USERNAME=
SMARTPROXY_PASSWORD=
SMARTPROXY_HOST=us.smartproxy.net
SMARTPROXY_PORT=3120
SMARTPROXY_SESSION_LIFETIME=10
SMARTPROXY_POOL_SIZE=10

# Geo-targeting (optional)
SMARTPROXY_COUNTRY=us
SMARTPROXY_STATE=
SMARTPROXY_CITY=
SMARTPROXY_ZIP=
SMARTPROXY_USE_LEGACY_FORMAT=

# =============================================================================
# AWS S3 Configuration (for report uploads)
# =============================================================================
# Alternative: use tools/aws_credentials.json (see aws_credentials.example.json)
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# Google Drive / Gmail OAuth
# =============================================================================
# OAuth credentials are stored in tools/oauth_credentials.json
# Tokens are cached in tools/oauth_token.json and tools/gmail_token.json
# See tools/README.md for setup instructions

# =============================================================================
# ClickUp Integration (optional)
# =============================================================================
CLICKUP_API_TOKEN=

# =============================================================================
# Browser Configuration (optional)
# =============================================================================
# Browser type for automation: patchright, playwright, or camoufox
BROWSER_TYPE=patchright

# Headless mode (set to false for debugging)
HEADLESS=true
