function getReadingProgress() {
    try {
        const dataDir = path.join(process.env.HOME, 'clawd', 'tools', '.reading-data');
        const booksFile = path.join(dataDir, 'books.json');
        const sessionsFile = path.join(dataDir, 'sessions.json');
        
        if (!fs.existsSync(booksFile)) {
            return { error: 'No reading data found' };
        }
        
        const books = JSON.parse(fs.readFileSync(booksFile, 'utf-8'));
        const sessions = fs.existsSync(sessionsFile) ? 
            JSON.parse(fs.readFileSync(sessionsFile, 'utf-8')) : [];
        
        const activeBooks = books.filter(book => book.status === 'reading');
        const recentSessions = sessions.filter(session => {
            const sessionDate = new Date(session.endTime || session.startTime);
            const dayAgo = new Date(Date.now() - 24 * 60 * 60 * 1000);
            return sessionDate >= dayAgo;
        });
        
        return {
            activeBooks: activeBooks.length,
            recentSessions: recentSessions.length,
            pagesYesterday: recentSessions.reduce((sum, s) => sum + (s.pages || 0), 0),
            currentBook: activeBooks[0] ? `${activeBooks[0].title} (${Math.round((activeBooks[0].currentPage || 0) / activeBooks[0].totalPages * 100)}%)` : 'None'
        };
    } catch (error) {
        return { error: 'Reading tracker data unavailable' };
    }
}

function getLearnings() {
    try {
        const dataDir = path.join(process.env.HOME, '.config');
        const learningsFile = path.join(dataDir, 'dev-learnings.json');
        
        if (!fs.existsSync(learningsFile)) {
            return { error: 'No learning data found' };
        }
        
        const data = JSON.parse(fs.readFileSync(learningsFile, 'utf-8'));
        const yesterday = new Date();
        yesterday.setDate(yesterday.getDate() - 1);
        yesterday.setHours(0, 0, 0, 0);
        
        const recentLearnings = data.learnings.filter(learning => {
            const learningDate = new Date(learning.timestamp);
            return learningDate >= yesterday;
        });
        
        return {
            total: data.learnings.length,
            yesterday: recentLearnings.length,
            recent: recentLearnings.slice(0, 2).map(l => ({
                content: l.content.substring(0, 60) + (l.content.length > 60 ? '...' : ''),
                category: l.category
            }))
        };
    } catch (error) {
        return { error: 'Learning tracker data unavailable' };
    }
}

function getGitStatus() {
    const repos = [
        path.join(process.env.HOME, 'clawd'),
        path.join(process.env.HOME, 'beena-monorepo'),
        path.join(process.env.HOME, 'irap-project'),
        path.join(process.env.HOME, 'scraping-base')
    ];
    
    let status = { clean: 0, dirty: 0, errors: 0, total: 0 };
    
    repos.forEach(repo => {
        if (!fs.existsSync(repo) || !fs.existsSync(path.join(repo, '.git'))) {
            return;
        }
        
        try {
            status.total++;
            const result = execSync('git status --porcelain', { 
                cwd: repo, 
                encoding: 'utf-8',
                timeout: 2000
            });
            
            if (result.trim()) {
                status.dirty++;
            } else {
                status.clean++;
            }
        } catch (error) {
            status.errors++;
        }
    });
    
    return status;
}

function getTimeAnalytics() {
    try {
        const dataFile = path.join(process.env.HOME, '.config', 'time-analytics.json');
        if (!fs.existsSync(dataFile)) {
            return { error: 'No time tracking data found' };
        }
        
        const data = JSON.parse(fs.readFileSync(dataFile, 'utf-8'));
        
        // Get yesterday's sessions
        const yesterday = new Date();
        yesterday.setDate(yesterday.getDate() - 1);
        const yesterdayStr = yesterday.toISOString().split('T')[0];
        
        const yesterdaySessions = data.sessions.filter(s => 
            s.endTime && s.endTime.startsWith(yesterdayStr)
        );
        
        if (yesterdaySessions.length === 0) {
            return { totalTime: '0h', sessions: 0, topCategory: 'None' };
        }
        
        const totalMinutes = yesterdaySessions.reduce((sum, session) => {
            const start = new Date(session.startTime);
            const end = new Date(session.endTime);
            return sum + Math.round((end - start) / (1000 * 60));
        }, 0);
        
        const categoryTotals = {};
        yesterdaySessions.forEach(session => {
            const start = new Date(session.startTime);
            const end = new Date(session.endTime);
            const minutes = Math.round((end - start) / (1000 * 60));
            
            categoryTotals[session.category] = (categoryTotals[session.category] || 0) + minutes;
        });
        
        const topCategory = Object.keys(categoryTotals).reduce((a, b) => 
            categoryTotals[a] > categoryTotals[b] ? a : b, Object.keys(categoryTotals)[0]
        );
        
        return {
            totalTime: `${Math.floor(totalMinutes / 60)}h ${totalMinutes % 60}m`,
            sessions: yesterdaySessions.length,
            topCategory: `${topCategory} (${Math.floor(categoryTotals[topCategory] / 60)}h ${categoryTotals[topCategory] % 60}m)`
        };
    } catch (error) {
        return { error: 'Time analytics data unavailable' };
    }
}

function getNSTTime() {
    // NST is UTC-3:30
    const now = new Date();
    const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
    const nst = new Date(utc + (-3.5 * 3600000));
    
    return nst.toLocaleString('en-CA', {
        weekday: 'long',
        year: 'numeric',
        month: 'long', 
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        timeZone: 'America/St_Johns'
    });
}

