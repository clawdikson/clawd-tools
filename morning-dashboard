function colorize(text, color) {
    return colors[color] + text + colors.reset;
}

function section(title, icon = '') {
    console.log(`\n${colorize(icon + ' ' + title, 'bright')}`);
    console.log(colorize('─'.repeat(50), 'gray'));
}

function getWeather() {
    try {
        // Use wttr.in for simple weather without API key
        const result = execSync('curl -s "https://wttr.in/St_Johns_NL?format=%C+%t+%f+%h+%w&u" 2>/dev/null', 
            { encoding: 'utf-8', timeout: 5000 }).trim();
        
        if (result && !result.includes('Unknown location')) {
            const parts = result.split(' ');
            return {
                condition: parts[0] || 'Unknown',
                temp: parts[1] || 'N/A',
                feels: parts[2] || 'N/A',
                humidity: parts[3] || 'N/A',
                wind: parts.slice(4).join(' ') || 'N/A'
            };
        }
    } catch (error) {
        // Silent fail
    }
    
    return {
        condition: 'Unknown',
        temp: 'N/A',
        feels: 'N/A', 
        humidity: 'N/A',
        wind: 'N/A'
    };
}

